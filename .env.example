# Run python infra/configure.py once to generate local credentials.
POSTGRES_PASSWORD=replace_with_random_hex
AIRFLOW_DB_PASSWORD=replace_with_random_hex
ODS_DB_PASSWORD=replace_with_random_hex
CONTROL_DB_PASSWORD=replace_with_random_hex
AIRFLOW_JWT_SECRET=replace_with_random_hex
AIRFLOW_ADMIN_PASSWORD=replace_with_random_hex
# Experimental v2 pacing ceiling, not a documented service limit. Range: 20..90.
ETL_MAX_RPM=40
# Page reads in flight (1..4); all starts still share one rate/budget.
ETL_PAGE_CONCURRENCY=4
ETL_STORES=postgres
ETL_STAGING_CLEANUP=1
